/*
 * Look Animator - brand and Inspector styles, added on top of the Veneer sheet.
 *
 * The accent is the exact Look Animator pink (#D6409F). The brand passes the class "look-accent" as its accent class, so the kit
 * adds no accent preset of its own and these rules are the only ones that set the accent variables.
 * The rest styles the two limit diagrams and the body bone rows. Spacing is margins only (no gap in USS).
 */

.vn-root.look-accent {
    --vn-accent: #D6409F;
    --vn-accent-soft: rgba(214, 64, 159, 0.16);
    --vn-accent-line: rgba(214, 64, 159, 0.55);
    --vn-pressed: rgba(214, 64, 159, 0.24);
}

.vn-root.vn-root--light.look-accent {
    --vn-accent: #B02A82;
    --vn-accent-soft: rgba(176, 42, 130, 0.14);
    --vn-accent-line: rgba(176, 42, 130, 0.60);
    --vn-pressed: rgba(176, 42, 130, 0.22);
}

/* ------------------------------------------------------------------ limit diagrams */

.look-diagrams {
    flex-direction: row;
    justify-content: center;
    margin: 2px 0 6px 0;
}

.look-diagram-column {
    align-items: center;
    margin: 0 10px;
}

.look-diagram {
    width: 112px;
    height: 112px;
    border-radius: 6px;
    background-color: var(--vn-track);
}

.look-diagram__image {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.look-diagram__dot {
    position: absolute;
    left: 52px;
    top: 52px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
    background-color: rgb(255, 255, 255);
    display: none;
}

.look-diagram__caption {
    margin: 3px 0 0 0;
    padding: 0;
    font-size: 10px;
    color: var(--vn-text-muted);
    -unity-text-align: upper-center;
}

.look-legend {
    margin: 0 0 6px 0;
    font-size: 10px;
    color: var(--vn-text-muted);
    white-space: normal;
    -unity-text-align: upper-center;
}

/* ------------------------------------------------------------------ body bone rows */

.look-bones__columns {
    flex-direction: row;
    justify-content: flex-end;
    margin: 0 0 3px 0;
}

.look-bones__columns-text {
    margin: 0 40px 0 0;
    padding: 0;
    font-size: 10px;
    color: var(--vn-text-muted);
}

.look-bone-row {
    flex-direction: row;
    align-items: center;
    padding: 3px 6px 3px 4px;
}

.look-bone-row__bone {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 60px;
    margin: 0 8px 0 0;
}

.look-bone-row__share {
    width: 96px;
    flex-shrink: 0;
    margin: 0 6px 0 0;
}

.look-bone-row__percent {
    width: 34px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 10px;
    color: var(--vn-text-muted);
    -unity-text-align: middle-right;
}
